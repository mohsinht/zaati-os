# Optional. The deploy workflow can materialize this JSON into instance.local.json.
ZAATI_INSTANCE_CONFIG_JSON=

# Optional. Recommended when a public code fork reads snapshots from a private data repository.
ZAATI_DATA_REPOSITORY=
ZAATI_DATA_REF=main

# Required only by the optional GitHub Actions Cloudflare deployment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
