{
  "$schema": "../schemas/workflow-registry.schema.json",
  "registry_version": "0.1.1",
  "workflows": [
    {
      "id": "daily-core",
      "label": "Daily core bundle",
      "description": "Refresh the primary daily sources and build the overview in one validated run.",
      "prompt": "prompts/daily-bundle.md",
      "source_ids": [
        "agenda:primary",
        "inbox:attention",
        "work:focus",
        "money:pulse",
        "news:briefing",
        "overview:daily"
      ],
      "max_attempts": 3,
      "publication": "single-commit"
    }
  ]
}
