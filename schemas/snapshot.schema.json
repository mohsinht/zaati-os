{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaati-os.dev/schemas/snapshot.schema.json",
  "title": "Zaati OS snapshot envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "snapshot_id",
    "source_id",
    "domain",
    "source",
    "generated_at",
    "effective_period",
    "status",
    "producer",
    "sources",
    "freshness",
    "quality",
    "privacy",
    "data"
  ],
  "properties": {
    "schema_version": { "const": "0.1.1" },
    "schema_ref": { "type": "string", "pattern": "^schemas/domains/[a-z0-9-]+\\.schema\\.json$" },
    "snapshot_id": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+:[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9-]+$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "effective_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "status": { "enum": ["success", "partial", "failed"] },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_id", "workflow", "version"],
      "properties": {
        "worker_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "workflow": { "enum": ["chatgpt", "claude", "gemini", "local", "custom", "manual", "example"] },
        "model": { "type": "string", "maxLength": 100 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "run_id": { "type": "string", "maxLength": 120 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "status", "as_of"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "status": { "enum": ["ok", "stale", "unavailable", "manual"] },
          "as_of": { "type": "string", "format": "date-time" },
          "reference": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at"],
      "properties": {
        "expires_at": { "type": "string", "format": "date-time" },
        "next_expected_at": { "type": "string", "format": "date-time" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "warnings"],
      "properties": {
        "confidence": { "enum": ["high", "medium", "low"] },
        "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_personal_data", "synthetic"],
      "properties": {
        "classification": { "enum": ["public", "private", "sensitive"] },
        "contains_personal_data": { "type": "boolean" },
        "synthetic": { "type": "boolean" }
      }
    },
    "data": { "type": "object" }
  }
}
