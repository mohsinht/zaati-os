{
  "name": "zaati-os",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "An open-source, private-by-default personal operating system powered by structured LLM snapshots.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run data:build && vite",
    "build": "npm run data:validate && npm run privacy:validate && npm run deployment:validate && npm run data:build && tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run build && npm test && npm run performance:check && npm run accessibility:check",
    "data:validate": "node scripts/validate-data.mjs",
    "data:build": "node scripts/build-data-index.mjs",
    "snapshot:ingest": "node scripts/ingest-bundle.mjs",
    "snapshot:keygen": "node scripts/generate-snapshot-key.mjs",
    "workflow:run": "node scripts/run-workflow.mjs",
    "tutorial": "node scripts/run-tutorial.mjs",
    "tutorial:check": "node scripts/run-tutorial.mjs --check",
    "privacy:validate": "node scripts/validate-privacy.mjs",
    "deployment:validate": "node scripts/validate-deployment.mjs",
    "performance:check": "node scripts/check-performance.mjs",
    "accessibility:check": "node scripts/check-accessibility.mjs",
    "deployment:configure": "node scripts/configure-deployment.mjs",
    "access:verify": "node scripts/verify-access.mjs",
    "instance:configure": "node scripts/configure-instance.mjs",
    "source:add": "node scripts/add-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run check && npm run deployment:configure && wrangler deploy --config .wrangler.generated.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.12.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.2",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=22"
  }
}
